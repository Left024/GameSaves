,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifier\":\"handnote\",\"unitCount\":1,\"uuid\":12,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemModifiedShape\":{\"<minX>k__BackingField\":15,\"<minY>k__BackingField\":2,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemType\":\"GameItemElement\",\"name\":\"李北文的奥克莫吸配方\",\"shortDescription\":\"普普通通的手写字条。\",\"flavorText\":\"\",\"uniqueId\":3050,\"unitBaseValue\":0,\"unitValue\":400,\"lateUnitValue\":0,\"backupUnitValue\":0,\"spriteAtlasPath\":\"Items\/items_misc\",\"spritePath\":\"handnote\",\"itemTypes\":[\"DOCUMENT\"],\"childItems\":[],\"childItemInventoryNode\":[],\"_keys\":[\"HANDNOTE_TITLE\",\"HANDNOTE_BODY\",\"HANDNOTE_SIGN\",\"HANDNOTE_FONT\",\"DOCUMENT\",\"IMPORTANT_TAG\",\"IS_OWNED_TAG\",\"PINNED_TAG\"],\"_values\":[{\"<identifier>k__BackingField\":\"HANDNOTE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_HANDNOTE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"奥克莫吸注射器\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"HANDNOTE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_HANDNOTE_BODY\",\"valueEnabled\":true,\"internalValueString\":\"第1步：原料准备\\n- 将几株梦帽菇搅拌成梦帽菇糊\\n第2步：萃取\\n- 加入相当于梦帽菇糊体积5倍的酒精\\n- 将混合物加热至40-50°C，制成梦帽菇萃取液\\n第3步：蒸发\\n- 用韧棉织物过滤，然后放入蒸发器\\n- （必需）确保所有水和酒精均已蒸发\\n第4步：反应\\n- 加入与梦帽菇萃取液等量的还原剂\\n- 再加入其四分之一量的脂合剂\\n- 将混合物加热至45-55°C，制成奥克莫吸\\n警告：梦帽菇萃取液超过60°C会变质\\n第5步：成型封装\\n- 再次过滤，并蒸发掉脂合剂\\n- 在化学制剂成型机中选择\“奥克莫吸注射器\”\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"HANDNOTE_SIGN\",\"<identifierName>k__BackingField\":\"TYPE-STRING_HANDNOTE_SIGN\",\"valueEnabled\":true,\"internalValueString\":\"李北文\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"HANDNOTE_FONT\",\"<identifierName>k__BackingField\":\"TYPE-STRING_HANDNOTE_FONT\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":2,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"DOCUMENT\",\"<identifierName>k__BackingField\":\"TYPE-STRING_DOCUMENT\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IMPORTANT_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IMPORTANT_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"PINNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_PINNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifier\":\"card_brewer\",\"unitCount\":1,\"uuid\":13,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":1,\"data\":[1,1],\"outside\":0},\"itemModifiedShape\":{\"