me>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAPER_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"导师笔记：物品标签\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_BODY\",\"valueEnabled\":true,\"internalValueString\":\" 部分物品可以更换标签。例如，你可以给一盒假冒香烟贴上正品标签，以此抬高售价。\\n\\n但要当心——大多数工人、治安部警官和下层区公民都对常见的造假手段了如指掌。诈骗企图将会失败，还会导致你的声望下降。\\n拾荒者虽然也熟悉物品造假，但他们通常不会随身携带鉴别真假的设备——如果需要用到设备的话。\\n相比之下，游客和上层区公民一般对此更加欠缺防备。\\n不过，纸包不住火，人们迟早会发现端倪的。\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_SIGNATURE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_SIGNATURE\",\"valueEnabled\":true,\"internalValueString\":\"——导师\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifier\":\"tutorial_page\",\"unitCount\":1,\"uuid\":45,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemModifiedShape\":{\"<minX>k__BackingField\":8,\"<minY>k__BackingField\":4,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemType\":\"GameItemElement\",\"name\":\"导师笔记：食品券\",\"shortDescription\":\"\",\"flavorText\":\"\",\"uniqueId\":37,\"unitBaseValue\":0,\"unitValue\":0,\"lateUnitValue\":0,\"backupUnitValue\":0,\"spriteAtlasPath\":\"Items\/itematlas\",\"spritePath\":\"tutorial_page\",\"itemTypes\":[\"DOCUMENT\"],\"childItems\":[],\"childItemInventoryNode\":[],\"_keys\":[\"DOCUMENT\",\"IMPORTANT_TAG\",\"TUTORIAL_PAPER_TAG\",\"IS_OWNED_TAG\",\"TUTORIAL_PAGE_TITLE\",\"TUTORIAL_PAGE_BODY\",\"TUTORIAL_PAGE_SIGNATURE\"],\"_values\":[{\"<identifier>k__BackingField\":\"DOCUMENT\",\"<identifierName>k__BackingField\":\"TYPE-STRING_DOCUMENT\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IMPORTANT_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IMPORTANT_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAPER_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAPER_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"导师笔记：食品券\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_BODY\",\"valueEnabled\":true,\"internalValueString\":\" 食品券是社会福利计划的一部分，旨在帮助符合条件的下层区公民，并预防社会动乱。\\n食品券可以用来在配给站兑换食物。\\n食品券有不同的面值。由于它们只能用来购买食物，因此人们经常以低于面值的价格将它们折现成信用点。\\n有时，伪造的食品券会被卖给毫无防备的受害者，这些人只有在兑换失败时才会发现自己上当受骗了。\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_SIGNATURE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_SIGNATURE\",\"valueEnabled\":true,\"internalValueString\":\"——导师\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifier\":\"tutorial_page\",\"unitCount\":1,\"uuid\":46,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemModifiedShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":6,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemType\":\"GameItemElement\",\"name\":\"导师笔记：改造体\",\"shortDescription\":\"\",\"flavorText\":\"\",\"uniqueId\":427,\"unitBaseValue\":0,\"unitValue\":0,\"lateUnitValue\":0,\"backupUnitValue\":0,\"spriteAtlasPath\":\"Items\/itematlas\",\"spritePath\":\"tutorial_page\",\"itemTypes\":[\"DOCUMENT\"],\"childItems\":[],\"childItemInventoryNode\":[],\"_keys\":[\"DOCUMENT\",\"IMPORTANT_TAG\",\"TUTORIAL_PAPER_TAG\",\"IS_OWNED_TAG\",\"TUTORIAL_PAGE_TITLE\",\"TUTORIAL_PAGE_BODY\",\"TUTORIAL_PAGE_SIGNATURE\"],\"_values\":[{\"<identifier>k__BackingField\":\"DOCUMENT\",\"<identifierName>k__BackingField\":\"TYPE-STRING_DOCUMENT\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IMPORTANT_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IMPORTANT_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAPER_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAPER_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"导师笔记：改造体\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_BODY\",\"valueEnabled\":true,\"internalValueString\":\"改造体是被脑部植入物中的失控AI接管的人类。他们的身体已不由自己控制，目前也没有能在不杀死宿主的情况下安全移除植入物的方法。改造体极度危险，充满敌意，会主动绑架他人并为其安装改造植入物。店主们是防范改造体的第一道防线，因为改造体需要原材料来制造新的植入物，还需要医疗物资为更多受害者实施植入手术。他们还无法完全模仿正常人的行为，也可能使用过分正式的措辞或机械生硬的词语。只有在完全确认其身份后才能开枪。不要呼叫治安部，改造体已经侵入了他们的通信系统，会在治安部赶到前逃之夭夭。\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_SIGNATURE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_SIGNATURE\",\"valueEnabled\":true,\"internalValueString\":\"——导师\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]}]}","cassettePlayerInvJSON":"{\"saveItems\":[{\"identifier\":\"save_bag\",\"unitCount\":1,\"uuid\":0,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":3,\"<